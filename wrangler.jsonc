{
  "name": "common-ground",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health", "/mcp"] },
  "workers_dev": true,
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 100 }
}
